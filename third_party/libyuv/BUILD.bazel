load("//third_party:shims.bzl", "forwarding_shim")

forwarding_shim(
    name = "libyuv",
    backend = "@libyuv",
    headers = [
        "libyuv.h",
        "libyuv/basic_types.h",
        "libyuv/compare.h",
        "libyuv/compare_row.h",
        "libyuv/convert.h",
        "libyuv/convert_argb.h",
        "libyuv/convert_from.h",
        "libyuv/convert_from_argb.h",
        "libyuv/cpu_id.h",
        "libyuv/cpu_support.h",
        "libyuv/loongson_intrinsics.h",
        "libyuv/mjpeg_decoder.h",
        "libyuv/planar_functions.h",
        "libyuv/rotate.h",
        "libyuv/rotate_argb.h",
        "libyuv/rotate_row.h",
        "libyuv/row.h",
        "libyuv/row_sve.h",
        "libyuv/scale.h",
        "libyuv/scale_argb.h",
        "libyuv/scale_rgb.h",
        "libyuv/scale_row.h",
        "libyuv/scale_uv.h",
        "libyuv/version.h",
        "libyuv/video_common.h",
