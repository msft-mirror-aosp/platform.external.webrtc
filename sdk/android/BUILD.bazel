# Manually maintained targets that must be located in the same BUILD file to not
# violate cross-package boundaries. Don't edit append/webrtc/sdk/android/BUILD
# to change what's below here, edit append/webrtc/sdk/android/BUILD.append instead.
#

LIBJINGLE_DT_SONAME = "libjingle_peerconnection_so.so"

ANDROID_LINKOPTS = [
    "-Wl,--build-id,-soname," + LIBJINGLE_DT_SONAME,
]

# The libjingle_peerconnection_so target cannot be generated since the google3
# BUILD generator doesn't support shared_libraries. This target should mirror
# the one in //webrtc/sdk/android/BUILD.gn.
android_jni_library(
    name = "libjingle_peerconnection_so",
    srcs = ["src/jni/jni_onload.cc"],
    binary_name = "libjingle_peerconnection_so.so",
    force_android = True,
    linkopts = ANDROID_LINKOPTS,
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//third_party/webrtc:friends"],
    deps = [
        ":libjingle_peerconnection_jni",
        ":libjingle_peerconnection_metrics_default_jni",
        "//third_party/webrtc/files/stable/webrtc/rtc_base:checks",
        "//third_party/webrtc/files/stable/webrtc/rtc_base:logging",
        "//third_party/webrtc/files/stable/webrtc/rtc_base:ssl_adapter",
        "//third_party/webrtc/files/stable/webrtc/sdk/android:base_jni",
