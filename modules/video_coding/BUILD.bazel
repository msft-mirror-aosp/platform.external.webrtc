# Manually added build targets, see:
# //third_party/webrtc/tools/append/webrtc/modules/video_coding/BUILD.append

# Since FFMpeg cannot be part of a release binary and "testonly" cannot be used
# because WebRTC internals depend on h264 headers, the Blaze flag
# --define="webrtc_ffmpeg_test_mode=1" is the best way to ensure FFMpeg is not
# leaking into a production binary through //modules/video_coding:webrtc_h264.
#
# *WARNING*: only use --define="webrtc_ffmpeg_test_mode=1" for testing purposes!

config_setting(
    name = "webrtc_ffmpeg_test_mode",
    values = {
        "define": "webrtc_ffmpeg_test_mode=1",
    },
)

cc_library(
    name = "conditional_dependency_on_ffmpeg_and_openh264",
    compatible_with = ["//buildenv/target:non_prod"],
    deps = select({
        ":webrtc_ffmpeg_test_mode": [
            "//third_party/ffmpeg:cmdutils",  # avcodec_alloc_context3
            "//third_party/ffmpeg:libavcodec-include",
            "//third_party/ffmpeg:libavformat-include",
            "//third_party/ffmpeg:libavutil-include",
            "//third_party/openh264",
        ],
        "//conditions:default": [],
    }),
)
